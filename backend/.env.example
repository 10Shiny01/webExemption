DB_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Autenticação JWT (use uma string longa e aleatória)
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio

# IA do Balanço Geral
AI_API_KEY=sua_chave_da_api_de_ia
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_MS=30000

# Alertas de validade (dias de antecedência)
DIAS_ALERTA_VALIDADE=7
