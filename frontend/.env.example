# URL base da API usada pelo frontend.
# Desenvolvimento: "/backend" (o proxy do Vite repassa ao Express).
# Produção: URL completa da API, por exemplo https://api.seudominio.com
VITE_API_URL=/backend

# Destino do proxy do Vite em desenvolvimento (porta definida em backend/app.js)
VITE_PROXY_TARGET=http://localhost:3000

# Dias de antecedência para marcar um produto como "próximo do vencimento".
# Use o mesmo valor de DIAS_ALERTA_VALIDADE do backend.
VITE_DIAS_ALERTA_VALIDADE=7
